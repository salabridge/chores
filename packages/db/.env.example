# Copy to packages/db/.env (gitignored). Point it at a dev branch, never production.
# See "Environment variables" in the root README for where each value comes from.

# Owner role (neondb_owner). Bypasses RLS: migrations, setup, admin jobs only.
DATABASE_URL="postgresql://neondb_owner:password@ep-example-pooler.c-4.us-west-2.aws.neon.tech/neondb?sslmode=require"
# authenticated_backend role. RLS applies: use for all user-facing queries.
DATABASE_AUTHENTICATED_URL="postgresql://authenticated_backend:password@ep-example-pooler.c-4.us-west-2.aws.neon.tech/neondb?sslmode=require"
# Neon Auth base URL for the same branch (JWKS + issuer for JWT verification).
NEON_AUTH_URL="https://ep-example.neonauth.c-4.us-west-2.aws.neon.tech/neondb/auth"

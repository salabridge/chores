# Copy to apps/web/.env (gitignored) and fill in values for your Neon branch.
# See "Environment variables" in the root README for where each value comes from.

# Postgres connection string for the Neon branch (Neon console > Connect, pooled).
DATABASE_URL="postgresql://neondb_owner:password@ep-example-pooler.c-4.us-west-2.aws.neon.tech/neondb?sslmode=require"
# Neon Auth base URL for the same branch (Neon console > Auth > Configuration).
# Neon's own SDK docs call this NEON_AUTH_BASE_URL.
NEON_AUTH_URL="https://ep-example.neonauth.c-4.us-west-2.aws.neon.tech/neondb/auth"

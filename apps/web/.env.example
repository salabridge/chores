# Copy to apps/web/.env (gitignored) and fill in values for your Neon branch.
# See "Environment variables" in the root README for where each value comes from.

# Postgres connection string for the Neon branch (Neon console > Connect, pooled).
DATABASE_URL="postgresql://neondb_owner:password@ep-example-pooler.c-4.us-west-2.aws.neon.tech/neondb?sslmode=require"
# Neon Auth base URL for the same branch (Neon console > Auth > Configuration).
# Neon's own SDK docs call this NEON_AUTH_BASE_URL.
NEON_AUTH_URL="https://ep-example.neonauth.c-4.us-west-2.aws.neon.tech/neondb/auth"

# Optional locally: the app's public origin, used for invite links. Set it in
# production. Unset, invite links use the origin the request came in on, and
# no invite email is sent.
APP_ORIGIN=""

# Optional: invite emails through Resend (resend.com > API Keys). Leave both
# unset locally: invites still work, the link shows on the Members screen and
# is logged to the dev server console instead of emailed.
RESEND_API_KEY=""
# From address on a domain verified in Resend.
INVITE_EMAIL_FROM=""

# Optional: PostHog product analytics (SB-85). Leave the key unset locally, in
# e2e and in previews: analytics is off, the SDK never loads and nothing is
# sent. Set it in Vercel for production only (PostHog > Project settings >
# Project API key).
PUBLIC_POSTHOG_KEY=""
# PostHog ingestion host the /ingest proxy forwards to. Unset means US Cloud.
PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

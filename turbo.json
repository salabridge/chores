{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"env": ["FIGMA_API_TOKEN", "FIGMA_FILE_KEY"],
			"passThroughEnv": [
				"DATABASE_URL",
				"NEON_AUTH_URL",
				"APP_ORIGIN",
				"RESEND_API_KEY",
				"INVITE_EMAIL_FROM",
				"PUBLIC_POSTHOG_KEY",
				"PUBLIC_POSTHOG_HOST",
				"POSTHOG_CLI_API_KEY",
				"POSTHOG_CLI_PROJECT_ID",
				"POSTHOG_CLI_HOST",
				"VERCEL_GIT_COMMIT_SHA"
			]
		},
		"test:ci": {
			"cache": false,
			"dependsOn": ["^test:ci"],
			"passThroughEnv": [
				"DATABASE_URL",
				"DATABASE_AUTHENTICATED_URL",
				"NEON_AUTH_URL"
			]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true,
			"passThroughEnv": [
				"DATABASE_URL",
				"DATABASE_AUTHENTICATED_URL",
				"NEON_AUTH_URL",
				"APP_ORIGIN",
				"RESEND_API_KEY",
				"INVITE_EMAIL_FROM",
				"PUBLIC_POSTHOG_KEY",
				"PUBLIC_POSTHOG_HOST",
				"FIGMA_API_TOKEN",
				"FIGMA_FILE_KEY"
			]
		}
	}
}

{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"env": ["FIGMA_API_TOKEN", "FIGMA_FILE_KEY"],
			"passThroughEnv": ["DATABASE_URL", "NEON_AUTH_URL"]
		},
		"test:ci": {
			"cache": false,
			"dependsOn": ["^test:ci"],
			"passThroughEnv": [
				"DATABASE_URL",
				"DATABASE_AUTHENTICATED_URL",
				"NEON_AUTH_URL"
			]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"passThroughEnv": [
				"DATABASE_URL",
				"DATABASE_AUTHENTICATED_URL",
				"NEON_AUTH_URL",
				"FIGMA_API_TOKEN",
				"FIGMA_FILE_KEY"
			]
		}
	}
}

{
	"name": "@chore/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest --run",
		"test:ci": "pnpm run test:unit -- --run && pnpm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"storybook": "storybook dev -p 6006 --no-open",
		"build-storybook": "storybook build"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@storybook/addon-a11y": "^10.6.1",
		"@storybook/addon-docs": "^10.6.1",
		"@storybook/addon-svelte-csf": "^5.1.5",
		"@storybook/sveltekit": "^10.6.1",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@vitest/browser-playwright": "^4.1.8",
		"playwright": "^1.60.0",
		"storybook": "^10.6.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@chore/db": "workspace:*",
		"@chores/tokens": "workspace:*",
		"@fontsource-variable/figtree": "^5.3.0",
		"@fontsource-variable/outfit": "^5.3.0",
		"@neondatabase/serverless": "^1.1.0",
		"arktype": "^2.2.5",
		"better-auth": "^1.7.5",
		"drizzle-orm": "catalog:"
	}
}

{
	"include": ["drizzle.config.ts", "schema/*", "src/*", "scripts/*"],
	"compilerOptions": {
		"strict": true,
		"sourceMap": true,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"types": ["@types/node"]
	}
}
